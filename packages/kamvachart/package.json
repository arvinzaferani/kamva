{
  "name": "kamvachart",
  "version": "1.0.0",
  "description": "Framework-agnostic, high-performance financial charting library.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "chart",
    "charting",
    "candlestick",
    "candlestick-chart",
    "trading",
    "financial",
    "stock",
    "technical-analysis",
    "canvas",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvinzaferani/kamva.git"
  },
  "homepage": "https://github.com/arvinzaferani/kamva",
  "bugs": {
    "url": "https://github.com/arvinzaferani/kamva/issues"
  },
  "author": {
    "name": "Arvin Zaferani",
    "url": "https://github.com/arvinzaferani"
  },
  "scripts": {
    "build": "tsup && rollup -c rollup.dts.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@kamvachart/chart-core": "workspace:*",
    "@kamvachart/indicators": "workspace:*",
    "@kamvachart/renderer-canvas": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  }
}